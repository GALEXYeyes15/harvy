# Copy to `.env.local` for local development (not committed).
# Used by Tauri native commands (Unsplash search) and Vite dev API fallbacks.
UNSPLASH_ACCESS_KEY=

# Optional: YouTube Data API key for richer YouTube outlier fetches (50 videos, comment counts).
# Without this, Harvy uses YouTube's public RSS feed (~15 recent videos).
# YOUTUBE_API_KEY=

# Optional: absolute base URL for Unsplash search API when not same-origin.
# VITE_UNSPLASH_API_BASE=
