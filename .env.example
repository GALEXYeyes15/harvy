# Copy to `.env.local` for local development (not committed).
# Used by Tauri native commands (format generation, etc.) and Vite dev API fallbacks.
OPENAI_API_KEY=

# Optional: absolute base URL for proofread API when not same-origin (e.g. Tauri production build).
# VITE_PROOFREAD_API_BASE=

# Optional: absolute base URL for format generation API when not same-origin.
# VITE_FORMAT_API_BASE=
