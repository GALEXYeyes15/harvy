{
  "name": "harvy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "ios:build": "tauri ios build --export-method debugging --ci",
    "ios:install": "rm -rf /tmp/harvy-ipa && mkdir -p /tmp/harvy-ipa && unzip -q src-tauri/gen/apple/build/arm64/*.ipa -d /tmp/harvy-ipa && xcrun devicectl device install app --device 00008130-0004516138EB8D3A /tmp/harvy-ipa/Payload/*.app",
    "ipad:build": "bash scripts/ipad-build.sh",
    "ios:dev":"tauri ios dev \"Alex’s iPad mini\" --host",
    "postinstall": "node scripts/copy-hunspell-dictionary.mjs"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "dictionary-en-us": "^2.2.1",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "nspell": "^2.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/cli": "~2.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.17",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
